{
	"name": "@twin.org/dataspace",
	"version": "0.0.0",
	"description": "Provides coordinated components for secure dataspace data exchange.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-dataspace.git"
	},
	"author": "jose.cantera@iota.org",
	"contributors": [
		"cornel.filip@iota.org",
		"adrian.sanchez.sequeira@iota.org",
		"martyn.janes@iota.org"
	],
	"license": "Apache-2.0",
	"private": false,
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "node ./scripts/workspaces.mjs build",
		"dist": "node ./scripts/workspaces.mjs dist",
		"dist:no-test": "node ./scripts/workspaces.mjs dist:no-test",
		"test": "node ./scripts/workspaces.mjs test",
		"format": "prettier --config prettier.config.mjs --write .",
		"lint:format": "prettier --config prettier.config.mjs --check .",
		"lint:code": "eslint . --cache --cache-location .eslintcache",
		"lint:markdown": "markdownlint **/*.md --ignore **/node_modules/** --ignore **/docs/reference/** --ignore **/changelog.md",
		"lint:spell": "cspell ** --no-progress",
		"lint": "npm run lint:format && npm run lint:code && npm run lint:markdown && npm run lint:spell",
		"docs": "node ./scripts/workspaces.mjs docs",
		"local-link": "node ./scripts/local-link.mjs",
		"commitlint": "commitlint --edit",
		"generate-release-configs": "node scripts/generate-release-configs.mjs release",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@eslint/eslintrc": "3.3.6",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@tony.ganchev/eslint-plugin-header": "3.4.4",
		"@typescript-eslint/eslint-plugin": "8.66.0",
		"@typescript-eslint/parser": "8.66.0",
		"cspell": "10.0.1",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsdoc": "63.3.3",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-unicorn": "73.0.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.9.0",
		"husky": "9.1.7",
		"markdownlint-cli": "0.49.1",
		"prettier": "3.9.6",
		"release-please": "17.10.4"
	},
	"workspaces": [
		"packages/dataspace-models",
		"packages/dataspace-test-app",
		"packages/dataspace-control-plane-service",
		"packages/dataspace-control-plane-rest-client",
		"packages/dataspace-data-plane-rest-client",
		"packages/dataspace-data-plane-socket-client",
		"packages/dataspace-app-runner",
		"packages/dataspace-data-plane-service"
	],
	"type": "module",
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"dataspace"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-dataspace/issues"
	},
	"homepage": "https://twindev.org"
}
