{
	"name": "@3sixty/dataspace-models",
	"version": "0.20.0-next.2",
	"description": "Defines shared entities, interfaces, and data types used by control plane and data plane components.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/dataspace.git",
		"directory": "packages/dataspace-models"
	},
	"author": "jose.cantera@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.4"
	},
	"scripts": {
		"clean": "rimraf dist coverage src/schemas src/compiled .cache",
		"build:schema": "ts-to-schema ./ts-to-schema.json ./src/schemas ./src/compiled --incremental",
		"build:compile": "tstransform",
		"build": "pnpm run build:schema && pnpm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts",
		"test:bun": "bunx --bun vitest --run --config ./vitest.config.ts",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts",
		"test:build": "tstransform -p ./tests/tsconfig.json",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && pnpm run build && concurrently -g -n locales,types,test \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && pnpm run build && concurrently -g -n locales,types \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/background-task-models": "next",
		"@3sixty/core": "next",
		"@3sixty/data-core": "next",
		"@3sixty/data-json-ld": "next",
		"@3sixty/entity": "next",
		"@3sixty/rights-management-models": "next",
		"@3sixty/standards-dataspace-protocol": "next",
		"@3sixty/standards-schema-org": "next",
		"@3sixty/standards-w3c-activity-streams": "next",
		"@3sixty/telemetry-models": "next",
		"@3sixty/web": "next"
	},
	"devDependencies": {
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/ts-to-schema": "next",
		"@3sixty/validate-locales": "next",
		"@vitest/coverage-v8": "5.0.5",
		"concurrently": "10.0.6",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.14.1",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"dataspace",
		"adapter",
		"integration",
		"models",
		"types",
		"schemas"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/dataspace/issues"
	},
	"homepage": "https://3sixty.global"
}
