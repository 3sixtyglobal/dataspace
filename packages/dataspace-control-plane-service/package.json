{
	"name": "@3sixty/dataspace-control-plane-service",
	"version": "0.20.0-next.0",
	"description": "Implements agreement negotiation and transfer process lifecycle management for control plane operations.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/dataspace.git",
		"directory": "packages/dataspace-control-plane-service"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/api-models": "next",
		"@3sixty/api-tenant-processor": "next",
		"@3sixty/background-task-models": "next",
		"@3sixty/context": "next",
		"@3sixty/core": "next",
		"@3sixty/data-json-ld": "next",
		"@3sixty/dataspace-models": "0.20.0-next.0",
		"@3sixty/entity": "next",
		"@3sixty/entity-storage-models": "next",
		"@3sixty/federated-catalogue-models": "next",
		"@3sixty/logging-models": "next",
		"@3sixty/nameof": "next",
		"@3sixty/rights-management-models": "next",
		"@3sixty/standards-dataspace-protocol": "next",
		"@3sixty/standards-w3c-dcat": "next",
		"@3sixty/standards-w3c-odrl": "next",
		"@3sixty/telemetry-models": "next",
		"@3sixty/trust-models": "next",
		"@3sixty/vault-models": "next",
		"@3sixty/web": "next"
	},
	"devDependencies": {
		"@3sixty/api-processors": "next",
		"@3sixty/api-server-fastify": "next",
		"@3sixty/entity-storage-connector-memory": "next",
		"@3sixty/federated-catalogue-service": "next",
		"@3sixty/logging-connector-entity-storage": "next",
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/rights-management-pap-service": "next",
		"@3sixty/rights-management-pip-service": "next",
		"@3sixty/rights-management-pnp-service": "next",
		"@3sixty/standards-dublin-core": "next",
		"@3sixty/standards-ld-contexts": "next",
		"@3sixty/trust-generators": "next",
		"@3sixty/trust-service": "next",
		"@3sixty/trust-verifiers": "next",
		"@3sixty/validate-locales": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"data",
		"space",
		"control",
		"plane",
		"service",
		"dataspace",
		"protocol",
		"dsp",
		"transfer",
		"process",
		"microservice",
		"business-logic"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/dataspace/issues"
	},
	"homepage": "https://3sixty.global"
}
