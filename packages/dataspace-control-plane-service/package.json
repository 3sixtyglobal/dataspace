{
	"name": "@twin.org/dataspace-control-plane-service",
	"version": "0.10.0",
	"description": "Implements agreement negotiation and transfer process lifecycle management for control plane operations.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-dataspace.git",
		"directory": "packages/dataspace-control-plane-service"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/api-models": "^0.10.0",
		"@twin.org/api-tenant-processor": "^0.10.0",
		"@twin.org/background-task-models": "^0.10.0",
		"@twin.org/context": "^0.10.0",
		"@twin.org/core": "^0.10.0",
		"@twin.org/data-json-ld": "^0.10.0",
		"@twin.org/dataspace-models": "^0.10.0",
		"@twin.org/entity": "^0.10.0",
		"@twin.org/entity-storage-models": "^0.10.0",
		"@twin.org/federated-catalogue-models": "^0.10.0",
		"@twin.org/logging-models": "^0.10.0",
		"@twin.org/nameof": "^0.10.0",
		"@twin.org/rights-management-models": "^0.10.0",
		"@twin.org/standards-dataspace-protocol": "^0.10.0",
		"@twin.org/standards-w3c-dcat": "^0.10.0",
		"@twin.org/standards-w3c-odrl": "^0.10.0",
		"@twin.org/telemetry-models": "^0.10.0",
		"@twin.org/trust-models": "^0.10.0",
		"@twin.org/vault-models": "^0.10.0",
		"@twin.org/web": "^0.10.0"
	},
	"devDependencies": {
		"@twin.org/api-processors": "^0.10.0",
		"@twin.org/api-server-fastify": "^0.10.0",
		"@twin.org/entity-storage-connector-memory": "^0.10.0",
		"@twin.org/federated-catalogue-service": "^0.10.0",
		"@twin.org/logging-connector-entity-storage": "^0.10.0",
		"@twin.org/nameof-transformer": "^0.10.0",
		"@twin.org/nameof-vitest-plugin": "^0.10.0",
		"@twin.org/rights-management-pap-service": "^0.10.0",
		"@twin.org/rights-management-pip-service": "^0.10.0",
		"@twin.org/rights-management-pnp-service": "^0.10.0",
		"@twin.org/standards-dublin-core": "^0.10.0",
		"@twin.org/standards-ld-contexts": "^0.10.0",
		"@twin.org/trust-generators": "^0.10.0",
		"@twin.org/trust-service": "^0.10.0",
		"@twin.org/trust-verifiers": "^0.10.0",
		"@twin.org/validate-locales": "^0.10.0",
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
