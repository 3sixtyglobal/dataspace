{
	"title": "TWIN Dataspace Connector",
	"version": "0.0.1",
	"description": "REST API Dataspace Connector.",
	"licenseName": "Apache 2.0 License",
	"licenseUrl": "https://opensource.org/licenses/Apache-2.0",
	"servers": ["http://localhost:3010"],
	"restRoutes": [
		{
			"packageRoot": "./"
		}
	],
	"authMethods": ["jwtBearer"],
	"externalReferences": {
		"JsonLd(.*?)": "https://schema.3sixty.global/json-ld/JsonLd$1",
		"ActivityStreams(.*)": "https://schema.3sixty.global/w3c-activity-streams/ActivityStreams$1",
		"Odrl(.*)": "https://schema.3sixty.global/w3c-odrl/Odrl$1",
		"DataspaceProtocol(.*?)": "https://schema.3sixty.global/dataspace-protocol/DataspaceProtocol$1",
		"Dcat(.*?)": "https://schema.3sixty.global/dcat/Dcat$1",
		"DublinCore(.*?)": "https://schema.3sixty.global/dublin-core/DublinCore$1",
		"Foaf(.*?)": "https://schema.3sixty.global/foaf/Foaf$1"
	},
	"autoExpandTypes": ["ActivityStreamsContextType"]
}
