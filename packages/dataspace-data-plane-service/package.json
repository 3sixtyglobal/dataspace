{
	"name": "@twin.org/dataspace-data-plane-service",
	"version": "0.0.3-next.32",
	"description": "Processes activities and data requests while enforcing transfer and policy constraints in the data plane.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-dataspace.git",
		"directory": "packages/dataspace-data-plane-service"
	},
	"author": "jose.cantera@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "npm run docs:clean && npm run docs:generate && npm run docs:api",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/api-models": "next",
		"@twin.org/background-task-models": "next",
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/data-core": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/dataspace-app-runner": "0.0.3-next.32",
		"@twin.org/dataspace-models": "0.0.3-next.32",
		"@twin.org/engine-models": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/federated-catalogue-models": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/modules": "next",
		"@twin.org/nameof": "next",
		"@twin.org/standards-dataspace-protocol": "next",
		"@twin.org/standards-schema-org": "next",
		"@twin.org/standards-w3c-activity-streams": "next",
		"@twin.org/standards-w3c-dcat": "next",
		"@twin.org/rights-management-models": "next",
		"@twin.org/standards-w3c-odrl": "next",
		"@twin.org/web": "next"
	},
	"devDependencies": {
		"@twin.org/background-task-service": "next",
		"@twin.org/background-task-scheduler": "next",
		"@twin.org/dataspace-test-app": "0.0.3-next.32",
		"@twin.org/context": "next",
		"@twin.org/federated-catalogue-service": "next",
		"@twin.org/modules": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/standards-ld-contexts": "next",
		"@twin.org/ts-to-openapi": "next",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.6",
		"copyfiles": "2.4.1",
		"dotenv": "17.4.2",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"tsc-watch": "7.2.0",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.6",
		"@twin.org/entity-storage-connector-file": "next"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"dataspace",
		"service",
		"microservice",
		"business-logic",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-dataspace/issues"
	},
	"homepage": "https://twindev.org"
}
