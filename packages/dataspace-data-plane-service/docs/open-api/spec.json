	},
	"servers": [
		{
			"url": "http://localhost:3010"
		}
	],
	"tags": [
		{
			"name": "Dataspace Data Plane",
			"description": "Endpoints to access a Dataspace Data Plane."
		}
	],
	"paths": {
		"/dataspace-data-plane/inbox": {
			"post": {
				"operationId": "activityStreamNotify",
				"summary": "Notify of a new Activity",
				"tags": [
					"Dataspace Data Plane"
				],
				"parameters": [
					{
						"name": "authorization",
						"in": "header",
						"required": true,
						"schema": {
							"type": "string"
						},
						"style": "simple"
					}
				],
				"requestBody": {
					"description": "Activity Stream Notify Request.",
					"required": true,
					"content": {
						"application/ld+json": {
							"schema": {
								"$ref": "https://schema.twindev.org/w3c-activity-streams/ActivityStreamsActivity"
							},
							"examples": {
								"activityStreamNotifyRequestExample": {
									"value": {
										"@context": "https://www.w3.org/ns/activitystreams",
										"type": "Add",
										"actor": {
											"id": "did:iota:testnet:0x123456"
										},
										"object": {
											"@context": "https://vocabulary.uncefact.org",
											"@type": "Consignment",
											"globalId": "24KEP051219453I002610796"
										},
										"updated": "2025-08-12T12:00:00Z"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Activity Stream Notify Response.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ActivityLogEntry"
								}
							}
						}
					},
					"400": {
						"description": "The server cannot process the request, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "GeneralError",
											"message": "errorMessage",
											"properties": {
												"foo": "bar"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"description": "The server has encountered a situation it does not know how to handle, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "InternalServerError",
											"message": "errorMessage"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/dataspace-data-plane/activity-logs/{id}": {
			"get": {
				"operationId": "dataspaceDataPlaneGetActivityLogEntry",
				"summary": "Get a Activity Log Entry",
				"tags": [
					"Dataspace Data Plane"
				],
				"parameters": [
					{
						"name": "id",
						"description": "The ID of the entry to get.",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						},
						"style": "simple",
						"example": "urn:x-activity-log:1234567"
					}
				],
				"security": [
					{
						"jwtBearerAuthScheme": []
					}
				],
				"responses": {
					"200": {
						"description": "Service Offering response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ActivityLogEntry"
								},
								"examples": {
									"activityLogEntryGetResponseExample": {
										"value": {
											"id": "urn:x-activity-log:134567",
											"dateCreated": "2025-08-12T12:00:00Z",
											"dateModified": "2025-08-12T12:00:00Z",
											"generator": "did:iota:testnet:123456",
											"status": "pending",
											"tasks": [
												{
													"taskId": "urn:x-task-id:45678",
													"dataspaceAppId": "https://my-app.example.org/app1",
													"status": "pending"
												}
											]
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "The server cannot process the request, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "GeneralError",
											"message": "errorMessage",
											"properties": {
												"foo": "bar"
											}
										}
									}
								}
							}
						}
					},
					"401": {
						"description": "You are not authorized to use the API or no credentials were supplied, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "UnauthorizedError",
											"message": "errorMessage"
										}
									}
								}
							}
						}
					},
					"500": {
						"description": "The server has encountered a situation it does not know how to handle, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "InternalServerError",
											"message": "errorMessage"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/dataspace-data-plane/entities": {
			"get": {
				"operationId": "dataspaceDataPlaneGetDataAssetEntities",
				"summary": "Get Data Asset Entities",
				"tags": [
					"Dataspace Data Plane"
				],
				"parameters": [
					{
						"name": "id",
						"description": "The ID of the entity(ies) to get. (comma separated list)",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "urn:ucr:24PLP051219453I002610799053311"
					},
					{
						"name": "type",
						"description": "The type of the entity to get.",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "https://vocabulary.uncefact.org/Consignment"
					},
					{
						"name": "consumerPid",
						"description": "The consumer Process ID from the DSP Transfer Process.\nMandatory - used to determine the Dataset, Distribution, and Agreement.\nThe datasetId is resolved from the Transfer Process using this ID.",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						},
						"example": "urn:uuid:consumer-pid-12345"
					},
					{
						"name": "dataServiceId",
						"description": "The Id of the data service that offers the data asset",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"description": "The maximum number of entities to retrieve.",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "cursor",
						"description": "Cursor to control pagination.",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "authorization",
						"in": "header",
						"required": true,
						"schema": {
							"type": "string"
						},
						"style": "simple"
					}
				],
				"responses": {
					"200": {
						"description": "Response containing data asset entities with optional pagination Link header.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DataAssetItemList"
								},
								"examples": {
									"dataAssetEntitiesGetResponseExample": {
										"value": {
											"@context": "https://schema.org",
											"type": "ItemList",
											"itemListElement": [
												{
													"@context": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld",
													"type": "Consignment",
													"id": "urn:ucr:PL527288386100000"
												}
											]
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "The server cannot process the request, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "GeneralError",
											"message": "errorMessage",
											"properties": {
												"foo": "bar"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"description": "The server has encountered a situation it does not know how to handle, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "InternalServerError",
											"message": "errorMessage"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/dataspace-data-plane/entities/query": {
			"post": {
				"operationId": "dataspaceDataPlaneQueryDataAsset",
				"summary": "Query Data Asset",
				"tags": [
					"Dataspace Data Plane"
				],
				"parameters": [
					{
						"name": "cursor",
						"description": "Opaque cursor token for pagination.",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"description": "Maximum number of items to return.",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "authorization",
						"in": "header",
						"required": true,
						"schema": {
							"type": "string"
						},
						"style": "simple"
					}
				],
				"requestBody": {
					"description": "Request to query data asset entities.",
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/DataAssetQueryRequest"
							},
							"examples": {
								"dataAssetQueryRequestExample": {
									"value": {
										"consumerPid": "urn:uuid:consumer-pid-12345",
										"query": {
											"type": "Example",
											"q": "example query"
										}
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Response containing data asset entities with optional pagination Link header.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DataAssetItemList"
								},
								"examples": {
									"dataAssetQueryResponseExample": {
										"value": {
											"@context": "https://schema.org",
											"type": "ItemList",
											"itemListElement": [
												{
													"@context": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld",
													"type": "Consignment",
													"id": "urn:ucr:PL527288386100000"
												}
											]
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "The server cannot process the request, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "GeneralError",
											"message": "errorMessage",
											"properties": {
												"foo": "bar"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"description": "The server has encountered a situation it does not know how to handle, see the content for more details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								},
								"examples": {
									"exampleResponse": {
										"value": {
											"name": "InternalServerError",
											"message": "errorMessage"
										}
									}
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"ActivityLogDetails": {
				"description": "The details related to the processing of an Activity",
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"description": "The Id of the Activity Log entry."
					},
					"activityId": {
						"type": "string",
						"description": "The activity Id that this entry refers to."
					},
					"generator": {
						"type": "string",
						"description": "The identity of the Activity's generator."
					},
					"dateCreated": {
						"type": "string",
						"description": "The creation date of this object."
					},
					"dateModified": {
						"type": "string",
						"description": "The last update date of this object."
					}
				},
				"required": [
					"id",
					"generator",
					"dateCreated",
					"dateModified"
				]
			},
			"ActivityLogEntry": {
				"description": "The details related to the processing of an Activity",
				"type": "object",
				"properties": {
					"status": {
						"$ref": "#/components/schemas/ActivityProcessingStatus"
					},
					"tasks": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ActivityTaskEntry"
						},
						"description": "The tasks that have to be run to process the Activity."
					}
				},
				"required": [
					"status"
				],
				"allOf": [
					{
						"$ref": "#/components/schemas/ActivityLogDetails"
					}
				]
			},
			"ActivityProcessingStatus": {
				"description": "The type exported.",
				"anyOf": [
					{
						"const": "pending",
						"description": "Pending: Activity Processing has not started yet."
					},
					{
						"const": "running",
						"description": "Running Activity processing is running."
					},
					{
						"const": "completed",
						"description": "Completed: Activity processing completed without error."
					},
					{
						"const": "error",
						"description": "Error: Activity processing cannot be performed and marked as in error. (Depends on application)."
					},
					{
						"const": "registering",
						"description": "Transient state. The background tasks associated with the activity are still being registered."
					}
				]
			},
			"ActivityTaskEntry": {
				"description": "Denotes a task associated with a Dataspace App",
				"type": "object",
				"properties": {
					"taskId": {
						"type": "string",
						"description": "Task Id."
					},
					"dataspaceAppId": {
						"type": "string",
						"description": "Dataspace App Id."
					},
					"status": {
						"$ref": "#/components/schemas/ActivityTaskStatus"
					},
					"processingGroupId": {
						"type": "string",
						"description": "Processing Group Id."
					},
					"startDate": {
						"type": "string",
						"description": "Task processing start timestamp"
					},
					"endDate": {
						"type": "string",
						"description": "Task processing end timestamp"
					},
					"result": {
						"description": "The result of the task processing, if completed."
					},
					"error": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [
					"taskId",
					"dataspaceAppId",
					"status"
				]
			},
			"ActivityTaskStatus": {
				"description": "Activity task statuses.",
				"anyOf": [
					{
						"const": "pending",
						"description": "Pending."
					},
					{
						"const": "processing",
						"description": "Processing."
					},
					{
						"const": "success",
						"description": "Success."
					},
					{
						"const": "failed",
						"description": "Failed."
					}
				]
			},
			"DataAssetItemList": {
				"description": "Interface describing a list of entities that are within a Data Asset.\nPagination is handled via HTTP Link headers.",
				"type": "object",
				"properties": {
					"@context": {
						"const": "https://schema.org",
						"description": "The LD Context."
					},
					"type": {
						"const": "ItemList",
						"description": "The type"
					},
					"itemListElement": {
						"type": "array",
						"items": {
							"$ref": "https://schema.twindev.org/json-ld/JsonLdNodeObject"
						},
						"description": "The components of the Collection"
					}
				},
				"required": [
					"@context",
					"type",
					"itemListElement"
				]
			},
			"DataAssetQueryRequest": {
				"type": "object",
				"properties": {
					"consumerPid": {
						"type": "string",
						"description": "The consumer Process ID from the DSP Transfer Process.\nMandatory - used to determine the Dataset, Distribution, and Agreement.\nThe datasetId is resolved from the Transfer Process using this ID."
					},
					"query": {
						"$ref": "#/components/schemas/FilteringQuery"
					}
				},
				"required": [
					"consumerPid",
					"query"
				],
				"description": "Request body containing the data asset and query criteria."
			},
			"Error": {
				"description": "Model to describe serialized error.",
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "The name for the error."
					},
					"message": {
						"type": "string",
						"description": "The message for the error as an i18n key."
					},
					"source": {
						"type": "string",
						"description": "The source of the error."
					},
					"properties": {
						"type": "object",
						"additionalProperties": {},
						"description": "Any additional information for the error."
					},
					"stack": {
						"type": "string",
						"description": "The stack trace for the error."
					},
					"cause": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [
					"name",
					"message"
				]
			},
			"FilteringQuery": {
				"description": "A query over a data asset that to be processed by a Dataspace Data Plane App.",
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"description": "The query type."
					},
					"q": {
						"description": "The representation of the query."
					},
					"jsonLdContext": {
						"type": "array",
						"items": {
							"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
						},
						"description": "The JSON-LD context to be applied over the query terms."
					}
				},
				"required": [
					"type",
					"q"
				]
			}
		},
		"securitySchemes": {
			"jwtBearerAuthScheme": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		}
	}
}
