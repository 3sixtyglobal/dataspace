{
	"name": "@twin.org/data-space-connector-app-runner",
	"version": "0.0.1-next.8",
	"description": "Data Space Connector App Runner",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/data-space-connector.git",
		"directory": "packages/data-space-connector-app-runner"
	},
	"author": "jose.cantera@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage docs/reference src/schemas",
		"build:compile": "tsc",
		"build": "npm run build:compile",
		"build:watch": "tsc-watch --onSuccess \"npm run bundle:esm\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tsc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"bundle:esm": "rollup --config rollup.config.mjs --environment MODULE:esm",
		"bundle:cjs": "rollup --config rollup.config.mjs --environment MODULE:cjs",
		"bundle": "npm run bundle:esm && npm run bundle:cjs",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test && npm run bundle && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run bundle && npm run docs",
		"prepare": "ts-patch install -s"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/data-space-connector-models": "0.0.1-next.8",
		"@twin.org/engine-models": "next",
		"@twin.org/engine-core": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/standards-w3c-activity-streams": "next"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "24.7.0",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.10",
		"rimraf": "6.0.1",
		"rollup": "4.52.4",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.13",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.cjs",
			"import": "./dist/esm/index.mjs"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/cjs",
		"dist/esm",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"data-space-connector",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/data-space-connector/issues"
	},
	"homepage": "https://twindev.org"
}
