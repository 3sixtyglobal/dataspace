{
	"name": "@twin.org/dataspace-test-app",
	"version": "0.11.0",
	"description": "Provides a sample dataspace app for local integration tests and development workflows.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-dataspace.git",
		"directory": "packages/dataspace-test-app"
	},
	"author": "jose.cantera@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage src/schemas",
		"build:compile": "tspc",
		"build": "pnpm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@twin.org/api-models": "^0.11.0",
		"@twin.org/context": "^0.11.0",
		"@twin.org/core": "^0.11.0",
		"@twin.org/data-core": "^0.11.0",
		"@twin.org/data-json-ld": "^0.11.0",
		"@twin.org/dataspace-models": "^0.11.0",
		"@twin.org/logging-models": "^0.11.0",
		"@twin.org/nameof": "^0.11.0",
		"@twin.org/standards-dataspace-protocol": "^0.11.0",
		"@twin.org/standards-dublin-core": "^0.11.0",
		"@twin.org/standards-w3c-activity-streams": "^0.11.0"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "^0.11.0",
		"@twin.org/nameof-vitest-plugin": "^0.11.0",
		"@twin.org/validate-locales": "^0.11.0",
		"@types/node": "26.6.2",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"dataspace",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-dataspace/issues"
	},
	"homepage": "https://twindev.org"
}
