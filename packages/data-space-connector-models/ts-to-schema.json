{
	"baseUrl": "https://schema.twindev.org/data-space-connector/",
	"types": ["./src/models/IDsProtocolDataset.ts"],
	"externalReferences": {
		"IJsonLd(.*)": "https://schema.twindev.org/json-ld/JsonLd$1",
		"IDataset": "https://schema.twindev.org/w3c-dcat/Dataset",
		"IOdrlOffer": "https://schema.twindev.org/w3c-odrl/OdrlOffer",
		"IDistribution": "https://schema.twindev.org/w3c-dcat/Distribution"
	},
	"overrides": {
		"IDsProtocolDataset": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "https://schema.twindev.org/data-space-connector/DsProtocolDataset",
			"description": "Dataset compliant with Eclipse Data Space Protocol. Validates only DS Protocol-specific requirements while allowing all optional DCAT properties.",
			"title": "DsProtocolDataset",
			"type": "object",
			"properties": {
				"@id": {
					"type": "string",
					"format": "uri",
					"description": "Unique identifier for the dataset. REQUIRED per Eclipse Data Space Protocol."
				},
				"@type": {
					"type": "string",
					"enum": ["Dataset"],
					"description": "The type identifier for the dataset. REQUIRED per Eclipse Data Space Protocol."
				},
				"odrl:hasPolicy": {
					"anyOf": [
						{
							"$ref": "https://schema.twindev.org/w3c-odrl/OdrlOffer"
						},
						{
							"type": "array",
							"minItems": 1,
							"items": {
								"$ref": "https://schema.twindev.org/w3c-odrl/OdrlOffer"
							}
						}
					],
					"description": "Array of ODRL policies (Offers) as required by DS Protocol. REQUIRED. Must contain at least one IOdrlOffer."
				},
				"dcat:distribution": {
					"anyOf": [
						{
							"allOf": [
								{
									"$ref": "https://schema.twindev.org/w3c-dcat/Distribution"
								},
								{
									"type": "object",
									"required": ["dcterms:format"]
								}
							]
						},
						{
							"type": "array",
							"minItems": 1,
							"items": {
								"allOf": [
									{
										"$ref": "https://schema.twindev.org/w3c-dcat/Distribution"
									},
									{
										"type": "object",
										"required": ["dcterms:format"]
									}
								]
							}
						}
					],
					"description": "Distribution of the dataset. REQUIRED per Eclipse Data Space Protocol."
				},
				"dcterms:type": {
					"type": "string",
					"format": "uri",
					"description": "The entity type this dataset offers. REQUIRED as per TWIN DS Protocol Profile"
				}
			},
			"required": ["@id", "@type", "odrl:hasPolicy", "dcat:distribution", "dcterms:type"],
			"additionalProperties": true
		}
	}
}
