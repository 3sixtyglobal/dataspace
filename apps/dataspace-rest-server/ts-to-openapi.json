{
	"title": "TWIN Dataspace Connector",
	"version": "0.0.1",
	"description": "REST API Dataspace Connector.",
	"licenseName": "Apache 2.0 License",
	"licenseUrl": "https://opensource.org/licenses/Apache-2.0",
	"servers": ["http://localhost:3010"],
	"restRoutes": [
		{
			"package": "@twin.org/api-service"
		},
		{
			"package": "@twin.org/dataspace-data-plane-service"
		},
		{
			"package": "@twin.org/dataspace-control-plane-service"
		}
	],
	"authMethods": ["jwtBearer"],
	"externalReferences": {
		"JsonLd(.*?)": "https://schema.twindev.org/json-ld/JsonLd$1",
		"ActivityStreams(.*?)": "https://schema.twindev.org/w3c-activity-streams/ActivityStreams$1",
		"Odrl(.*)": "https://schema.twindev.org/w3c-odrl/Odrl$1",
		"DataspaceProtocol(.*?)": "https://schema.twindev.org/dataspace-protocol/DataspaceProtocol$1",
		"Dcat(.*?)": "https://schema.twindev.org/dcat/Dcat$1",
		"DublinCore(.*?)": "https://schema.twindev.org/dublin-core/DublinCore$1",
		"Foaf(.*?)": "https://schema.twindev.org/foaf/Foaf$1"
	},
	"autoExpandTypes": ["ActivityStreamsContextType"]
}
